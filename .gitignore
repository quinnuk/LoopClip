# PyInstaller build artifacts (regenerated by `python -m PyInstaller LoopClip.spec`)
build/
dist/
*.spec.bak

# The finished .exe (rebuild locally rather than committing a binary)
LoopClip.exe

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
.venv/
env/

# Packaging/metadata
*.egg-info/
pip-wheel-metadata/

# App settings (per-user, lives in %APPDATA%\LoopClip normally, but
# ignored here too in case anything gets created locally during testing)
settings.json

# Editor/IDE
.vscode/
.idea/
*.swp

# OS cruft
Thumbs.db
desktop.ini
dist/LoopClip.exe
